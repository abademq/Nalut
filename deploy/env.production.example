APP_NAME=NalutDelivery
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Tripoli
APP_URL=http://SERVER_IP
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nalut
DB_USERNAME=nalut
DB_PASSWORD=

# ⚠️ redis إجباري: مواقع السائقين تتخزن في الكاش،
# و file cache ما يشتغلش صح مع أكثر من عملية PHP-FPM
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CLIENT=phpredis

FCM_PROJECT_ID=nalut-delivery
FCM_CREDENTIALS_PATH=storage/app/firebase.json

DELIVERY_BASE_FEE=5
DELIVERY_FEE_PER_KM=1.5
DELIVERY_FREE_RADIUS_KM=1
PLATFORM_COMMISSION_PERCENT=15

OSRM_URL=https://router.project-osrm.org
ROAD_DISTANCE_FACTOR=1.3

MAIL_MAILER=log

# ---------- رموز التحقق ----------
# log = بدون إرسال (للتجربة) · resala = SMS عبر رسالة
OTP_DRIVER=log
OTP_LENGTH=4
OTP_TTL_SECONDS=300
# ⚠️ true يرجّع الرمز في الاستجابة — للتجربة فقط، false قبل أي مستخدم حقيقي
OTP_DEV_MODE=false
OTP_SERVICE_NAME=Nalut
# أرقام برمز ثابت بدون إرسال (مراجعي Google Play): "0913333333:1234"
OTP_TEST_NUMBERS=

RESALA_API_TOKEN=
# true = ما تنبعتش رسائل حقيقية ولا ينخصم رصيد
RESALA_TEST=false

# ---------- كروت الشحن ----------
# عدد أرقام الكرت (8-16). 12 = آمن ضد التخمين، 8 = أقصر لكن أضعف
RECHARGE_CARD_DIGITS=12
